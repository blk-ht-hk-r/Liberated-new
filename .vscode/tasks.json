{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Backend",
      "type": "shell",
      "command": "mvn spring-boot:run",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "env": {
        "SPRING_PROFILES_ACTIVE": "local"
      },
      "problemMatcher": ["$maven"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Build Backend",
      "type": "shell",
      "command": "mvn -DskipTests package",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": ["$maven"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Run Mobile",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/mobile"
      },
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Run Both",
      "dependsOn": ["Run Backend", "Run Mobile"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": false
      }
    }
  ]
}
