{
  "expo": {
    "name": "Liberated",
    "slug": "liberated",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "liberated",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#01332F"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.liberated.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Liberated uses the camera so you can privately capture proof of your daily task. This photo stays only on your device.",
        "NSPhotoLibraryUsageDescription": "Liberated lets you attach a photo as private proof of your daily task. It stays only on your device."
      }
    },
    "android": {
      "package": "com.liberated.app",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Liberated lets you attach a photo as private proof. It stays only on your device.",
          "cameraPermission": "Liberated uses the camera to privately capture proof of your task."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "apiBaseUrl": "http://192.168.1.2:8080",
      "googleMock": false,
      "googleIosClientId": "678040958972-fi0di67gh6vclc4g7cpgp21tfdujn3tj.apps.googleusercontent.com",
      "googleAndroidClientId": "678040958972-3hofhb11bas7verl1alvore9t2ipa0kb.apps.googleusercontent.com",
      "googleWebClientId": "678040958972-igkfrkq71eak8qf4t2aafgsr8op020qu.apps.googleusercontent.com",
      "appleMock": true
    }
  }
}
